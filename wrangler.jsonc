{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "government-support-search",
  "main": "./_worker.js",
  "compatibility_date": "2026-10-14",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "SUPPORTS_DB",
      "database_name": "government-support-search-db",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": [
      "15 18 * * *"
    ]
  }
}
